flowchart TD
    A["Этап 0. Подготовка<br/>Требования, стенд, тестовые данные"] --> B["Этап 1. Основа<br/>Аутентификация, права,<br/>соревнования и задачи"]
    B --> C["Этап 2. Проверка решений<br/>Посылка, очередь, Docker,<br/>вердикты и очистка"]
    C --> D["Этап 3. Рейтинг и история<br/>Дедлайны, версии,<br/>таблица результатов"]
    D --> E["Этап 4. Нефункциональные проверки<br/>Нагрузка, ёмкость, совместимость,<br/>удобство и отказы"]
    E --> F{"P0-прогоны пройдены?<br/>Нет критичных дефектов?"}
    F -- Нет --> G["Исправить дефекты<br/>и выполнить регрессию"]
    G --> C
    F -- Да --> H["Этап 5. Приёмка<br/>Smoke, P0-регрессия,<br/>итоговый протокол"]
    H --> I{"Все Must и NFR<br/>проверены?"}
    I -- Нет --> J["Зафиксировать блокеры<br/>и ограничения"]
    J --> E
    I -- Да --> K["Решение о готовности<br/>к выпуску"]

    subgraph Traceability["Наборы проверок плана"]
        T1["AUTH / ACCESS<br/>Регистрация, токены,<br/>объектные права"]
        T2["COMP / DEADLINE<br/>Соревнования, задачи,<br/>дедлайны и версии"]
        T3["SUBMIT / RUN / FAIL<br/>Посылки, Docker, вердикты,<br/>системные сбои"]
        T4["SCORE / EXPORT<br/>Рейтинг, история,<br/>экспорт CSV (Should)"]
        T5["PERF / CAP / UX<br/>Производительность, ёмкость,<br/>совместимость"]
    end

    B -.-> T1
    B -.-> T2
    C -.-> T3
    D -.-> T4
    E -.-> T5

    classDef phase fill:#eaf2f8,stroke:#2874a6,color:#17202a
    classDef gate fill:#fcf3cf,stroke:#b7950b,color:#17202a
    classDef result fill:#e8f8f5,stroke:#148f77,color:#17202a
    classDef trace fill:#f4ecf7,stroke:#7d3c98,color:#17202a
    class A,B,C,D,E,G,H,J phase
    class F,I gate
    class K result
    class T1,T2,T3,T4,T5 trace
