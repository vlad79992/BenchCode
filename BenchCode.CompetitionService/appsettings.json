{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runner": {
    "Address": "https+http://programRunner/"
  },
  "RabbitMQ": {
    "FastQueueName": "benchcode.submissions.fast",
    "FullQueueName": "benchcode.submissions.full",
    "DeadLetterExchangeName": "benchcode.submissions.dlx",
    "DeadLetterQueueName": "benchcode.submissions.dead",
    "PrefetchCount": 1,
    "FastReplyTimeoutSeconds": 45,
    "FastMessageTtlMilliseconds": 45000,
    "RunnerAttempts": 3,
    "RunnerRetryDelayMilliseconds": 500
  },
  "SubmissionOutbox": {
    "PollIntervalMilliseconds": 500,
    "BatchSize": 20,
    "InitialRetryDelayMilliseconds": 500,
    "MaxRetryDelayMilliseconds": 30000
  }
}
