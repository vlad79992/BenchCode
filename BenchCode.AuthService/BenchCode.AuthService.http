@BenchCode.AuthService_HostAddress = https://localhost:7231

POST {{BenchCode.AuthService_HostAddress}}/api/users
Content-Type: application/json

{
  "userName": "alice",
  "email": "alice@example.com",
  "password": "Replace-Me-123!"
}

###

POST {{BenchCode.AuthService_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=compose-web-app&username=alice&password=Replace-Me-123!&scope=benchcode-api%20offline_access

###

@access_token = paste-access-token-here

GET {{BenchCode.AuthService_HostAddress}}/api/users/me
Authorization: Bearer {{access_token}}
Accept: application/json

###

@refresh_token = paste-refresh-token-here

POST {{BenchCode.AuthService_HostAddress}}/connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=refresh_token&client_id=compose-web-app&refresh_token={{refresh_token}}

###
