<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <CollectCoverage>true</CollectCoverage>
        <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <ItemGroup>
    	<!-- Aliases нужен потому что top level statements находятся в глобальном неймспейсе, а Program есть во всех проектах, Aliases - это способ их различать -->
        <ProjectReference Include="..\BenchCode.AuthService\BenchCode.AuthService.csproj" Aliases="global,AuthService" />
        <ProjectReference Include="..\BenchCode.ProgramRunnerService\BenchCode.ProgramRunnerService.csproj" Aliases="global,RunnerService" />
        <ProjectReference Include="..\BenchCode.CompetitionService\BenchCode.CompetitionService.csproj" Aliases="global,CompetitionService" />
        <ProjectReference Include="..\BenchCode.Gateway\BenchCode.Gateway.csproj" Aliases="global,Gateway" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>
